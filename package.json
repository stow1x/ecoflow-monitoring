{
  "name": "ecoflow-monitoring",
  "version": "0.1.0",
  "description": "Prometheus exporter and Grafana stack for EcoFlow power stations",
  "keywords": [
    "ecoflow",
    "prometheus",
    "grafana",
    "exporter",
    "monitoring",
    "delta-3",
    "river-2"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test",
    "capture": "node tools/capture.ts"
  },
  "dependencies": {
    "ky": "^2.0.2",
    "mqtt": "^5.15.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@9.12.3",
  "homepage": "https://github.com/stow1x/ecoflow-monitoring#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stow1x/ecoflow-monitoring.git"
  },
  "bugs": {
    "url": "https://github.com/stow1x/ecoflow-monitoring/issues"
  },
  "author": "Artem Sedliar"
}
