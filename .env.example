# EcoFlow monitoring — copy to .env and fill in.
#
# Two data paths, selected by ECOFLOW_MODE:
#
#   official — AccessKey/SecretKey from the EcoFlow developer portal
#              (https://developer.ecoflow.com). REST polling plus the public MQTT stream.
#   private  — the email and password of your EcoFlow mobile-app account, using the
#              same app API and MQTT stream the phone app uses.
#
# Which one do you need? Try official first, and watch for API error code 1006
# ("current device is not allowed to get device info"). 1006 means EcoFlow has not
# exposed your device category to the Developer API: /device/list still works, quota
# calls return 1006, and the public MQTT quota topic stays silent forever. Nothing on
# your side can fix that, so those devices require private mode. Verified on this
# project's own hardware: DELTA 3 1500 (D361…) and RIVER 2 (R601…) both return 1006.

# private | official — data path used by the exporter. Default: private
ECOFLOW_MODE=private

# private mode: EcoFlow mobile-app account email. Required when ECOFLOW_MODE=private
ECOFLOW_EMAIL=

# private mode: EcoFlow mobile-app account password. Required when ECOFLOW_MODE=private
ECOFLOW_PASSWORD=

# official mode: developer-portal AccessKey. Required when ECOFLOW_MODE=official
ECOFLOW_ACCESS_KEY=

# official mode: developer-portal SecretKey. Required when ECOFLOW_MODE=official
ECOFLOW_SECRET_KEY=

# API host override. Default: https://api.ecoflow.com (private) / https://api-e.ecoflow.com (official, EU)
ECOFLOW_API_HOST=

# Host used for the signed device-list call. api-e is Europe, api-a is the Americas; a key
# presented to the wrong one answers 8513. Default: https://api-e.ecoflow.com
ECOFLOW_DISCOVERY_HOST=

# Comma-separated serial allow-list.
# REQUIRED in private mode, because the app API has no device-list endpoint — unless you also set
# ECOFLOW_ACCESS_KEY and ECOFLOW_SECRET_KEY, which lets the exporter discover devices over the
# official API and learn their model names.
# In official mode it is optional and an empty value exports every device on the account.
ECOFLOW_SERIALS=

# official mode: seconds between REST quota polls. Server-side data refreshes every ~15 min, so lower buys nothing. Default: 60
POLL_INTERVAL_SECONDS=60

# private mode: seconds between forced snapshot requests on top of the push stream. Default: 300
SNAPSHOT_INTERVAL_SECONDS=300

# Seconds a device's telemetry stays valid; past this ecoflow_device_up drops to 0 and stale series are removed. Default: 900
DEVICE_TTL_SECONDS=900

# TCP port for /metrics, /healthz and /readyz. Default: 9101
EXPORTER_PORT=9101

# error | warn | info | debug — debug logs unmapped payload keys once each. Default: info
LOG_LEVEL=info

# Optional directory for raw frames as NDJSON; empty disables dumping. Under compose the container is read-only, so this must point at a writable mount. Default: empty
DUMP_RAW_DIR=

# Grafana admin password for user "admin". Required — compose refuses to start without it. Default: none
GRAFANA_PASSWORD=
