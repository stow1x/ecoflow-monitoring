          "format": "table"
        },
        {
          "refId": "REMAIN",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_remaining_capacity_amp_hours{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "FULL",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_full_capacity_amp_hours{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "VOLT",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_voltage_volts{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "CHGLIM",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_charge_limit_percent{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "DSGLIM",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_discharge_limit_percent{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "serial",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "__name__ 3": true,
              "__name__ 4": true,
              "__name__ 5": true,
              "instance": true,
              "instance 1": true,
              "instance 2": true,
              "instance 3": true,
              "instance 4": true,
              "instance 5": true,
              "job": true,
              "job 1": true,
              "job 2": true,
              "job 3": true,
              "job 4": true,
              "job 5": true,
              "model 2": true,
              "model 3": true,
              "model 4": true,
              "model 5": true,
              "Time 6": true,
              "__name__ 6": true,
              "instance 6": true,
              "job 6": true,
              "model 6": true,
              "Time 7": true,
              "__name__ 7": true,
              "instance 7": true,
              "job 7": true,
              "model 7": true
            },
            "renameByName": {
              "model 1": "Model",
              "serial": "Serial",
              "Value #SOH": "State of health",
              "Value #CYCLES": "Cycles",
              "Value #REMAIN": "Remaining",
              "Value #FULL": "Full capacity",
              "Value #VOLT": "Pack voltage",
              "Value #CHGLIM": "Charge limit",
              "Value #DSGLIM": "Discharge limit"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State of health"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Remaining"
            },
            "properties": [
              {
                "id": "unit",
                "value": "amph"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Full capacity"
            },
            "properties": [
              {
                "id": "unit",
                "value": "amph"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pack voltage"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*limit"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Lifetime energy counters",
      "description": "Odometers reported by the device, not a rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "ecoflow-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_energy_charged_watt_hours{serial=~\"$serial\"} > 0",
