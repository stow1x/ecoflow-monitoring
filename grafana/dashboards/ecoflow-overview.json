        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*current.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "amp"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
