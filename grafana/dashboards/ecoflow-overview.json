            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Battery health",
      "datasource": {
        "type": "prometheus",
        "uid": "ecoflow-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "SOH",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_soh_percent{serial=~\"$serial\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "CYCLES",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_battery_cycles{serial=~\"$serial\"}",
