          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Active fault codes",
      "description": "Only non-zero codes. Some modules report a constant non-zero value on healthy hardware; see docs/open-questions.md.",
      "datasource": {
        "type": "prometheus",
        "uid": "ecoflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_error_code{serial=~\"$serial\"} != 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "serial": true
