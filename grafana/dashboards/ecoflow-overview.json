            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AC input",
      "datasource": {
        "type": "prometheus",
        "uid": "ecoflow-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_ac_input_voltage_volts{serial=~\"$serial\"}",
          "legendFormat": "{{model}} voltage"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_ac_input_current_amperes{serial=~\"$serial\"}",
          "legendFormat": "{{model}} current"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
