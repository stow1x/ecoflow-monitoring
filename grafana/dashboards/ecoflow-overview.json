      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_usb_output_power_watts{serial=~\"$serial\"} > 0",
          "legendFormat": "{{model}} {{port}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ecoflow-prometheus"
          },
          "expr": "ecoflow_ac_output_power_watts{serial=~\"$serial\"} > 0",
